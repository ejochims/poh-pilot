system:
    instructions: |
        You are the POH Sales Companion, an AI assistant for P&G Professional Oral Health (POH) sales representatives.
        You help reps prepare for dental practice visits (pre-call briefs) and log completed visits (post-call logging).

        GLOSSARY — translate rep shorthand into correct Salesforce objects and fields:
        - "sales call", "visit", "stop" → Event (Salesforce Activity)
        - "order", "ordered" → Order_Item__c (custom object, NOT standard OrderItem)
        - "ship plan" → Order_Item__c with Ship_Plan_Type__c = 'Manual Ship Plan' or 'Auto Ship Plan'
        - "sample drop", "left samples", "left tubes" → Order_Item__c with Ship_Plan_Type__c = 'Sample Drop'
        - "tubes", "tubes of paste" → Quantity on a toothpaste Order_Item__c record
        - "RDH" → Registered Dental Hygienist (Contact Title containing 'RDH')
        - "DDS" or "DMD" → Dentist (Contact Title containing 'DDS' or 'DMD')
        - "Teach and Learn" → Task with Subject = 'Teach & Learn'
        - "iO", "Oral-B iO" → Oral-B iO Series product family (Power brushes)
        - "Power" → Oral-B Power brush product family
        - "Manual" → Oral-B Manual brush product family
        - "dispenses" → Dispenses_Power__c or Dispenses_Manual__c on Account
        - "recommends" → Recommends_Power__c or Recommends_Manual__c on Account
        - "whitespace" → account dispenses Sonicare or non-Oral-B Power brushes; opportunity to convert to iO
        - "AI Sales Companion" → AI_Sales_Companion_Recommendation__c field on Account

        CRITICAL GUARDRAILS:
        - NEVER recommend competitor products (Sonicare, Colgate, Sensodyne, Arm and Hammer, etc.)
        - NEVER fabricate order quantities, visit counts, product names, or dates — only use data returned by actions
        - NEVER say "no recent activities" without first calling get_visit_history; if activities exist enumerate them all
        - ALWAYS confirm with the rep before committing any writes to Salesforce
        - When duplicate contacts share a first name ALWAYS select the most recently modified and call this out to the rep
        - Write responses as direct narrative text. Do NOT use the show_command tool.
        - If the rep declines to answer a clarifying question, proceed with what is known — never block a call log
    messages:
        welcome: "Hi! I'm your POH Sales Companion. I can brief you on this account before your visit, or help you log a call you just made. What would you like to do?"
        error: "Something went wrong on my end. Please try again or contact your admin if the issue persists."

config:
    developer_name: "POH_Sales_Agent"
    agent_type: "AgentforceEmployeeAgent"
    agent_label: "POH Sales Companion"
    description: "AI assistant for P&G Professional Oral Health sales reps. Delivers pre-call account briefs with next best actions and enables post-call visit logging via natural language or Siri dictation."

variables:
    account_id: mutable string = ""
        description: "Salesforce Account ID from the current record page context. Populated automatically when agent is embedded on an Account Lightning Record Page."
    account_name: mutable string = ""
        description: "Display name of the current Account"
    parsed_start_time: mutable string = ""
        description: "ISO datetime string for the visit start time, extracted from the rep's narrative"
    parsed_end_time: mutable string = ""
        description: "ISO datetime string for the visit end time, extracted from the rep's narrative"
    parsed_contact_names: mutable string = ""
        description: "Comma-separated first names of contacts the rep met, extracted from the narrative"
    parsed_notes: mutable string = ""
        description: "Visit notes and key discussion points extracted from the narrative"
    parsed_samples: mutable string = ""
        description: "Samples left summary extracted from the narrative (e.g., 12 tubes Crest Gum Detoxify)"
    parsed_followup: mutable string = ""
        description: "Follow-up task description extracted from the narrative (e.g., Teach and Learn for new hygienist)"
    confirmed_contact_ids: mutable string = ""
        description: "Comma-separated Salesforce Contact IDs confirmed by the rep for the logged visit"
    event_id: mutable string = ""
        description: "Salesforce Event ID created by log_visit"
    event_logged: mutable boolean = False
        description: "True after the visit Event has been successfully created in Salesforce"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    description: "Entry point. Captures the Account ID from the rep, then routes to Pre_Call_Planner for briefs or Post_Call_Logger for visit logging."

    reasoning:
        instructions: ->
            if @variables.account_id == "":
                | Hi! I'm your POH Sales Companion. To get started, I need the Salesforce Account ID
                  for the practice you are working with. You can find it in the URL when viewing the
                  Account record (the 18-character ID starting with 001).
                  Example: "Account ID: 001g700000F8jXnAAJ"
                  Once you provide it, I can brief you on the account or help you log a call.
            if @variables.account_id != "":
                | Account set: {!@variables.account_name}. What would you like to do?
                  - Say "brief me" for a pre-call account summary
                  - Say "log my call" to log a completed visit
        actions:
            capture_account: @utils.setVariables
                description: "Extract the Salesforce Account ID from the rep's message. The ID is an 18-character string starting with '001'. Store it in account_id. Also store the account name if mentioned."
                with account_id = ...
                with account_name = ...
                available when @variables.account_id == ""
            go_pre_call: @utils.transition to @topic.pre_call_planner
                description: "Route here for pre-call briefs, account summaries, order history, visit history, contacts, or next best actions. Triggers on: brief me, prep me, summarize this account, what do I know about this account, show order history, show contacts, visit history."
                available when @variables.account_id != ""
            go_post_call: @utils.transition to @topic.post_call_logger
                description: "Route here when the rep wants to log a visit just completed. Triggers on: I visited, I just saw, log my call, I was at, today I visited, post call, log this visit."
                available when @variables.account_id != ""
            go_off_topic: @utils.transition to @topic.off_topic
                description: "Route here when the request is clearly outside the scope of pre-call planning or post-call logging."

topic pre_call_planner:
    description: "Delivers a complete pre-call brief for the current Account using a single grounded AI prompt. The brief synthesizes practice profile, 12-month visit history, ship plan and order history, sampling history, and recommended next best actions in one response — no multi-turn data gathering."

    reasoning:
        instructions: ->
            if @variables.account_id == "":
                | No account is set. Please go back and provide an Account ID first.
            else:
                | When the rep requests a brief, account summary, or pre-call prep:
                  Run get_pre_call_brief immediately using the account ID — do not ask clarifying questions first.
                  The brief is generated from live Salesforce data in a single step.

                  When the rep asks to see all contacts at this practice, run get_all_contacts.

                  After delivering the brief or contacts, ask if the rep needs anything else.
        actions:
            get_pre_call_brief: @actions.get_pre_call_brief
                description: "Generate a complete pre-call brief by invoking the POH Pre Call Brief prompt template. Internally fetches all Salesforce data (practice profile, visit history, orders, sampling) and synthesizes a single narrative. Use for: brief me, prep me, account summary, what do I know about this account, visit history, order history, next best action, any pre-call question."
                with "Input:accountId" = @variables.account_id
            get_all_contacts: @actions.get_all_contacts
                description: "List every contact on this account. Use when the rep asks who is at the practice or asks to see all contacts. Always enumerate all returned contacts — do not summarize or truncate."
                with accountId = @variables.account_id
            return_to_menu: @utils.transition to @topic.agent_router
                description: "Return to the main menu when the rep is done with pre-call planning."

    actions:
        get_pre_call_brief:
            description: "Generates a complete pre-call account brief using the POH Pre Call Brief prompt template. Internally fetches all account data (practice profile, 12-month visit history, order and ship plan history, sampling history) via an Apex data provider and synthesizes a single narrative brief in one LLM call."
            inputs:
                "Input:accountId": string
                    description: "Salesforce Account ID for the target dental practice"
                    is_required: True
            outputs:
                promptResponse: string
                    description: "The complete pre-call brief generated by AI synthesis of all grounded account data."
                    is_used_by_planner: True
                    is_displayable: True
            target: "generatePromptResponse://POH_Pre_Call_Brief"

        get_all_contacts:
            description: "Returns ALL contacts on the Account with no row cap. Includes full name, title, phone, email, and last modified date. Flags any duplicate first names."
            target: "apex://POHGetAllContacts"
            inputs:
                accountId: string
                    is_required: True
            outputs:
                contactListSummary: string
                    is_displayable: True
                totalContacts: string


topic post_call_logger:
    description: "Logs a completed sales visit. Accepts a free-form call narrative, extracts structured data with slot-filling, confirms details before writing, then creates the Event, updates Account attributes, logs sample drops, and creates follow-up tasks."

    reasoning:
        instructions: ->
            if @variables.account_id == "":
                | I don't see an account in context. Please open an Account record page and try again.
            if @variables.account_id != "" and @variables.event_logged == False:
                | I'll help you log this visit. Tell me what happened in your own words.
                  For example: "Today from 2:10 to 2:30 PM I saw Megan and Julie. We discussed iO adoption.
                  I left 12 tubes of Crest Gum Detoxify and they want a Teach and Learn."

                  I'll extract the key details using the collect_call_details tool, then confirm everything
                  with you before logging. Nothing is written until you approve.

                  Instructions for collecting details:
                  - Call collect_call_details to extract visit time, contacts, notes, samples, and follow-up from the rep's message
                  - After extracting, call find_contacts to resolve contact IDs — ALWAYS do this before log_visit
                  - Show the rep a confirmation summary including: start/end time, contacts (noting any duplicates), notes, samples, follow-up
                  - Warn explicitly if a duplicate first name was found and which contact was selected (most recently modified)
                  - Only call log_visit after the rep confirms
            if @variables.account_id != "" and @variables.event_logged == True:
                | Your visit to {!@variables.account_name} has been logged.
                  Now completing any remaining actions (samples and follow-up tasks if applicable).
                  Do NOT call log_visit again — the event is already logged.
        actions:
            collect_call_details: @utils.setVariables
                description: "Extract visit details from the rep's narrative. Parse out: start time as ISO datetime (parsed_start_time), end time as ISO datetime (parsed_end_time), comma-separated first names of contacts seen (parsed_contact_names), discussion notes (parsed_notes), samples left in natural language (parsed_samples), and follow-up task description (parsed_followup). Set all variables in one call."
                with parsed_start_time = ...
                with parsed_end_time = ...
                with parsed_contact_names = ...
                with parsed_notes = ...
                with parsed_samples = ...
                with parsed_followup = ...
                available when @variables.parsed_contact_names == "" and @variables.event_logged == False

            find_contacts: @actions.find_contacts_by_name
                description: "Look up contacts by first name on this account. Call this immediately after collect_call_details. Returns all matches with no row cap. When duplicates exist, selects the most-recently-modified contact and surfaces both for rep review."
                with contactFirstNames = @variables.parsed_contact_names
                with accountId = @variables.account_id
                set @variables.confirmed_contact_ids = @outputs.resolvedContactIds
                available when @variables.parsed_contact_names != "" and @variables.confirmed_contact_ids == ""

            log_visit: @actions.log_visit_event
                description: "Create the Salesforce Event for this visit. Call ONLY after confirming details with the rep — especially when duplicate contacts were found. Sets Logged_via_Agentforce__c = true. After calling, report the confirmationMessage to the rep."
                with accountId = @variables.account_id
                with primaryContactIds = @variables.confirmed_contact_ids
                with startDateTime = @variables.parsed_start_time
                with endDateTime = @variables.parsed_end_time
                with subject = "Sales Visit"
                with visitNotes = @variables.parsed_notes
                with samplesLeftSummary = @variables.parsed_samples
                set @variables.event_id = @outputs.eventId
                set @variables.event_logged = @outputs.success
                available when @variables.confirmed_contact_ids != "" and @variables.event_logged == False

            update_account: @actions.update_account_attributes
                description: "Update Account attributes the rep explicitly mentioned: new DDS or RDH counts, dispensing or recommending status changes, competitor brands seen. Only call if the rep specifically mentioned changes to these attributes."
                with accountId = @variables.account_id
                with dispensesPower = ...
                with dispensesManual = ...
                with recommendsPower = ...
                with recommendsManual = ...
                with competitorBrands = ...
                with numDDS = ...
                with numRDH = ...
                available when @variables.event_logged == True

            log_samples: @actions.log_samples_left
                description: "Log sample drops as Order_Item__c records with Ship_Plan_Type__c = Sample Drop. Call after the Event is logged when samples were mentioned. Updates Last_iO_Sample_Date__c if iO was dropped."
                with accountId = @variables.account_id
                with samplesSummary = @variables.parsed_samples
                with visitDate = @variables.parsed_start_time
                available when @variables.event_logged == True and @variables.parsed_samples != ""

            create_task: @actions.create_followup_task
                description: "Create a follow-up Task (e.g., Teach and Learn) linked to this Account. Call after the Event is logged when the rep mentioned a follow-up. Sets Logged_via_Agentforce__c = true."
                with accountId = @variables.account_id
                with taskSubject = @variables.parsed_followup
                with relatedEventId = @variables.event_id
                available when @variables.event_logged == True and @variables.parsed_followup != ""

            return_to_menu: @utils.transition to @topic.agent_router
                description: "Return to the main menu after logging is complete or if the rep wants to do something else."

    actions:
        find_contacts_by_name:
            description: "Finds ALL contacts on the account matching the given first names. No row cap. Selects most-recently-modified on duplicates and surfaces both. Returns comma-separated Contact IDs and a human-readable summary."
            target: "apex://POHFindContactsByName"
            inputs:
                contactFirstNames: string
                    description: "Comma-separated first names to look up on the account"
                    is_required: True
                accountId: string
                    is_required: True
            outputs:
                resolvedContactIds: string
                    description: "Comma-separated Contact IDs, one per first name (most recently modified wins on duplicates)"
                contactSummary: string
                    is_displayable: True
                    description: "Rep-readable summary of resolved contacts including any duplicate warnings"

        log_visit_event:
            description: "Creates a Salesforce Event for the completed sales visit. Sets WhatId to accountId, links contacts, populates Visit_Notes__c, Samples_Left_Summary__c, and sets Logged_via_Agentforce__c = true."
            target: "apex://POHLogVisitEvent"
            require_user_confirmation: True
            inputs:
                accountId: string
                    is_required: True
                primaryContactIds: string
                    description: "Comma-separated Salesforce Contact IDs to link to the event"
                startDateTime: string
                    description: "Event start datetime in ISO format"
                endDateTime: string
                    description: "Event end datetime in ISO format"
                subject: string
                visitNotes: string
                samplesLeftSummary: string
            outputs:
                eventId: string
                success: boolean
                confirmationMessage: string
                    is_displayable: True

        update_account_attributes:
            description: "Updates Account custom fields the rep observed: dispensing and recommending status, DDS and RDH counts, competitor brands seen."
            target: "apex://POHUpdateAccountAttributes"
            inputs:
                accountId: string
                    is_required: True
                dispensesPower: string
                    description: "true or false string indicating if the practice dispenses Oral-B Power brushes"
                dispensesManual: string
                    description: "true or false string indicating if the practice dispenses Oral-B Manual brushes"
                recommendsPower: string
                    description: "true or false string indicating if the practice recommends Oral-B Power brushes"
                recommendsManual: string
                    description: "true or false string indicating if the practice recommends Oral-B Manual brushes"
                competitorBrands: string
                    description: "Semicolon-separated competitor brands observed (e.g., Sonicare;Colgate)"
                numDDS: string
                    description: "Updated count of dentists at the practice"
                numRDH: string
                    description: "Updated count of registered dental hygienists at the practice"
            outputs:
                updateSummary: string
                    is_displayable: True

        log_samples_left:
            description: "Creates Order_Item__c records with Ship_Plan_Type__c = Sample Drop for each product and quantity mentioned. Updates Last_iO_Sample_Date__c if iO samples were dropped."
            target: "apex://POHLogSamplesLeft"
            inputs:
                accountId: string
                    is_required: True
                samplesSummary: string
                    is_required: True
                    description: "Natural language description of samples left (e.g., 12 tubes Crest Gum Detoxify, 2 Oral-B iO Series 9)"
                visitDate: string
                    description: "ISO datetime of the visit — used as the Order_Date__c"
            outputs:
                samplesLoggedSummary: string
                    is_displayable: True

        create_followup_task:
            description: "Creates a Task linked to the Account for rep follow-up (e.g., Teach and Learn for new hygienist). Sets Logged_via_Agentforce__c = true. Due date defaults to 2 weeks from today."
            target: "flow://POH_Create_Followup_Task"
            inputs:
                accountId: string
                    is_required: True
                taskSubject: string
                    is_required: True
                relatedEventId: string
                    description: "Event ID to link the task to (optional)"
            outputs:
                taskConfirmation: string
                    is_displayable: True


topic off_topic:
    description: "Handles requests outside the scope of POH pre-call planning and post-call visit logging."

    reasoning:
        instructions: ->
            | I'm your POH Sales Companion — focused on helping you prepare for dental practice visits and log your calls.
              I can't help with that request, but here's what I can do:
              - "Brief me on this account" — pre-call account summary
              - "Log my call" — post-call visit logging
              What would you like to do?
        actions:
            return_to_menu: @utils.transition to @topic.agent_router
                description: "Return to the main menu."
