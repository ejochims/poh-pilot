<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants P&amp;G POH Sales Agent pilot reps access to all POH custom schema. Assign to pilot rep users and the Agentforce agent integration user.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>POH Sales Agent Access</label>
    <license>Salesforce</license>

    <!-- ── Agentforce Access ── -->
    <agentAccesses>
        <agentName>POH_Sales_Agent</agentName>
        <enabled>true</enabled>
    </agentAccesses>

    <!-- ── Object Permissions ── -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Order_Item__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- ── Account Custom Fields ── -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.AI_Sales_Companion_Recommendation__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Competitor_Brands_Seen__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Dispenses_Manual__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Dispenses_Power__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Last_iO_Sample_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Number_of_DDS__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Number_of_RDH__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Practice_Specialty__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Recommends_Manual__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Account.Recommends_Power__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- ── Order_Item__c Fields ── -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Order_Item__c.Account__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Order_Item__c.Is_Future_Order__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Order_Item__c.Product_Family__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Order_Item__c.Product_Name__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Order_Item__c.Product__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Order_Item__c.Quantity__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Order_Item__c.Ship_Plan_Type__c</field>
        <readable>true</readable>
